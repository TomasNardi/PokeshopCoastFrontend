# ─── Backend (Django, mismo contrato que Crack) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Dominio público del bucket de R2 (fotos y catálogo). Vacío en local: las sirve el backend.
NEXT_PUBLIC_MEDIA_URL=

# true  → el front usa los repositorios en memoria (src/mocks). Default mientras no hay backend.
# false → usa los repositorios HTTP contra NEXT_PUBLIC_API_URL.
# Con mocks, demora artificial (ms) para revisar esqueletos de carga. Vacío = sin demora.
# NEXT_PUBLIC_MOCK_LATENCY_MS=1500
NEXT_PUBLIC_USE_MOCKS=true

# Dominio canónico (sitemaps, canonical, redirects de OAuth y de recuperación).
NEXT_PUBLIC_SITE_URL=https://pokeshopcoast.com

# ─── Cuentas (Supabase Auth: Google SSO + email/contraseña + recuperación) ───
# Clave PÚBLICA (sb_publishable_… o anon). Nunca la service_role.
# Sin estas dos, y con mocks apagados, las cuentas se apagan solas y el sitio vende igual.
#
# Google SSO: Supabase → Authentication → Providers → Google (client id/secret de GCP).
# Redirect URLs permitidas: <SITE_URL>/cuenta y <SITE_URL>/cuenta/restablecer
#
# Emails de auth (confirmación, recuperación): Supabase → Auth → SMTP Settings
# con Resend (smtp.resend.com:465, user "resend", pass = RESEND_API_KEY).
# La API key de Resend vive SOLO en Supabase y en el backend, nunca en el front.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Contacto ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_PHONE=5492257554759
NEXT_PUBLIC_CONTACT_EMAIL=hola@pokeshopcoast.com

# Modo presentación: true = en producción solo se ve la home (se configura en Vercel).
# En local dejarlo en false para trabajar con todo el sitio.
NEXT_PUBLIC_HOME_ONLY=false

# Login de prueba contra el backend local (tomi / tomi). Solo desarrollo: nunca en Vercel.
NEXT_PUBLIC_DEV_LOGIN=false

# ─── Solo servidor (sin NEXT_PUBLIC_: nunca llegan al navegador) ────────────
# Misma clave que INTERNAL_API_KEY del backend: el SSR de Vercel no cuenta
# contra el rate limit (todo Vercel sale de pocas IPs).
INTERNAL_API_KEY=

# Sitio en mantenimiento: se prende/apaga en el admin (Configuración de la
# tienda → Sitio → "Sitio activo"). Para ver la tienda igual mientras está
# cerrada, entrá una vez a  <SITE_URL>/vista-previa?token=<este valor>
# (salir: /vista-previa?salir=1). Usá un texto largo y aleatorio.
MAINTENANCE_PREVIEW_TOKEN=
